.container {
  position: relative;
  height: 100vh;
  background: #000;
}

.camera {
  width: 100%;
  height: 70%;
}

.guide-frame {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  height: 40%;
  border: 2rpx dashed rgba(255, 255, 255, 0.5);
}

.frame-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #1890ff;
}

.frame-corner.top-left {
  top: -4rpx;
  left: -4rpx;
  border-right: none;
  border-bottom: none;
}

.frame-corner.top-right {
  top: -4rpx;
  right: -4rpx;
  border-left: none;
  border-bottom: none;
}

.frame-corner.bottom-left {
  bottom: -4rpx;
  left: -4rpx;
  border-right: none;
  border-top: none;
}

.frame-corner.bottom-right {
  bottom: -4rpx;
  right: -4rpx;
  border-left: none;
  border-top: none;
}

.frame-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}

.controls {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 60rpx;
}

.record-info {
  margin-bottom: 30rpx;
}

.record-time {
  color: #ff4d4f;
  font-size: 36rpx;
  font-weight: bold;
}

.button-group {
  display: flex;
  align-items: center;
  justify-content: space-around;
  width: 100%;
  margin-bottom: 30rpx;
}

.btn-cancel {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel text {
  color: #fff;
  font-size: 28rpx;
}

.btn-record {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-record.recording {
  background: #ff4d4f;
}

.record-inner {
  width: 60rpx;
  height: 60rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

.btn-record.recording .record-inner {
  width: 50rpx;
  height: 50rpx;
  background: #fff;
  border-radius: 8rpx;
}

.btn-placeholder {
  width: 120rpx;
  height: 120rpx;
}

.hint-text {
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
}
