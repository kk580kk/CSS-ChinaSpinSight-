.container {
  min-height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
}

.video-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-video {
  width: 100%;
  height: 100%;
}

.upload-progress {
  padding: 40rpx;
  background: #1a1a1a;
}

.progress-bar {
  height: 8rpx;
  background: #333;
  border-radius: 4rpx;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: #1890ff;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  color: #fff;
  font-size: 28rpx;
  text-align: center;
}

.actions {
  display: flex;
  gap: 30rpx;
  padding: 40rpx;
  background: #1a1a1a;
}

.btn-primary {
  flex: 1;
  background: #1890ff;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 30rpx 0;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  flex: 1;
  background: transparent;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 30rpx 0;
  border: 2rpx solid #fff;
}

.btn-secondary::after {
  border: none;
}
