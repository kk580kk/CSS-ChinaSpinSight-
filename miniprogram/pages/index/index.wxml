<view class="container">
  <!-- Header -->
  <view class="header">
    <text class="title">ChinaSpinSight</text>
    <text class="subtitle">AI 乒乓球旋转检测</text>
  </view>

  <!-- History List -->
  <view class="history-section">
    <text class="section-title">历史记录</text>
    
    <view class="history-list" wx:if="{{history.length > 0}}">
      <view 
        class="history-item" 
        wx:for="{{history}}" 
        wx:key="id"
        bindtap="onViewHistory"
        data-task-id="{{item.task_id}}"
      >
        <view class="history-main">
          <text class="spin-value">{{item.spin_rounds}} 圈</text>
          <text class="spin-level">{{getSpinLevelText(item.spin_rounds)}}</text>
        </view>
        <view class="history-meta">
          <text class="confidence">置信度 {{(item.confidence * 100).toFixed(0)}}%</text>
          <text class="time">{{formatTime(item.created_at)}}</text>
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无检测记录</text>
      <text class="empty-hint">点击下方按钮开始检测</text>
    </view>
  </view>

  <!-- Start Button -->
  <view class="action-section">
    <button class="btn-primary" bindtap="onStartDetect">
      开始检测
    </button>
  </view>
</view>
