/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.user-header {
  background: linear-gradient(135deg, #667eea, #764ba2);
  padding: 60rpx 40rpx;
  display: flex;
  justify-content: center;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
}

.nickname {
  color: #fff;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-icon {
  font-size: 80rpx;
}

.login-text {
  color: rgba(255,255,255,0.8);
  font-size: 28rpx;
  margin: 20rpx 0;
}

.btn-login {
  background: #fff;
  color: #667eea;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}

.menu-list {
  background: #fff;
  margin-top: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}

.version {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 24rpx;
}
