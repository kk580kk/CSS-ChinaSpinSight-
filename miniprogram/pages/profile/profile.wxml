<!--pages/profile/profile.wxml-->
<view class="container">
  <!-- User Header -->
  <view class="user-header">
    <view wx:if="{{userInfo}}" class="user-info">
      <image class="avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill"></image>
      <text class="nickname">{{userInfo.nickname || '用户'}}</text>
    </view>
    <view wx:else class="login-prompt">
      <text class="login-icon">👤</text>
      <text class="login-text">登录后查看更多功能</text>
      <button class="btn-login" bindtap="onLogin">微信登录</button>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onViewHistory">
      <text class="menu-icon">📋</text>
      <text class="menu-text">检测历史</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="onViewGuide">
      <text class="menu-icon">📷</text>
      <text class="menu-text">使用教程</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="onFeedback">
      <text class="menu-icon">💬</text>
      <text class="menu-text">意见反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="onAbout">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- Settings -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onClearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- Version -->
  <view class="version">
    <text>ChinaSpinSight v1.0.0</text>
  </view>
</view>
