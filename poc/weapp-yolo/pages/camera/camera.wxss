/* pages/camera/camera.wxss */
.container {
  min-height: 100vh;
  background-color: #000;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background-color: #000;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.stats-toggle {
  width: 120rpx;
  text-align: right;
}

.stats-text {
  font-size: 24rpx;
  color: #07c160;
}

.camera-container {
  position: relative;
  width: 100%;
  height: 70vh;
}

.camera {
  width: 100%;
  height: 100%;
}

.detection-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.detection-box {
  position: absolute;
  border: 4rpx solid #07c160;
  border-radius: 8rpx;
  background-color: rgba(7, 193, 96, 0.1);
}

.detection-label {
  position: absolute;
  top: -36rpx;
  left: 0;
  background-color: #07c160;
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.stats-panel {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-width: 180rpx;
}

.stat-item.recording {
  background-color: rgba(255, 107, 107, 0.3);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.stat-value {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
  margin-left: 20rpx;
}

.controls {
  display: flex;
  justify-content: space-around;
  padding: 40rpx;
}

.control-group {
  flex: 1;
  margin: 0 20rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #07c160, #10b981);
  color: #fff;
}

.btn-secondary {
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  color: #fff;
}

.btn-danger {
  background: linear-gradient(135deg, #ff4757, #ff6b6b);
  color: #fff;
}

.tips {
  text-align: center;
  padding: 20rpx;
}

.tips text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}
