/* pages/loading/loading.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.2);
  border-top-color: #07c160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.download-icon {
  font-size: 80rpx;
}

.success-icon {
  font-size: 80rpx;
}

.error-icon {
  font-size: 80rpx;
}

.message {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 40rpx;
}

.progress-container {
  width: 100%;
  max-width: 500rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #07c160, #10b981);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.progress-text {
  display: block;
  text-align: center;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
}

.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-message {
  font-size: 28rpx;
  color: #ff6b6b;
  margin-bottom: 40rpx;
  text-align: center;
}

.action-buttons {
  display: flex;
  gap: 30rpx;
}

.btn {
  padding: 24rpx 48rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #07c160, #10b981);
  color: #fff;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}
